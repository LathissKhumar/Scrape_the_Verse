# =================================================================
# SCRAPE THE VERSE - ENVIRONMENT CONFIGURATION
# =================================================================

# --- Ollama Local LLM Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60.0

# --- Bright Data Configuration ---
# Set to True to enable Bright Data Scraper Studio & REST API fast path
BRIGHTDATA=True
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Pre-configured Bright Data Scraper Studio Collectors:
# 1. B2B Tier-1 Discovery Collector (e.g. IndiaMART Search)
BRIGHTDATA_DISCOVERY_COLLECTOR_ID=c_mt1klz941e6wjo8o6y
# 2. B2B Tier-2 Company Profile Enrichment Collector (e.g. IndiaMART PDP/Profile)
BRIGHTDATA_COMPANY_COLLECTOR_ID=c_mt1n1d372h5qpcxcvh
# 3. Google Maps Local Lead Discovery Collector
BRIGHTDATA_GMAPS_COLLECTOR_ID=c_mt1qfvqx1051f3m8r9

# --- Scraper Provider Strategy ---
# Options: 'auto' (recommended), 'brightdata', 'local'
SCRAPER_PROVIDER=auto

# --- Headless Browser Automation (Playwright Native Engine) ---
CRAWLER_HEADLESS=true
CRAWLER_TIMEOUT_MS=30000
MAX_BROWSER_CONCURRENCY=5

# --- Application & Security Configuration ---
APP_ENV=development
LOG_LEVEL=INFO
# Optional: Set an API Secret Key to require 'X-API-Key' or 'Authorization: Bearer <key>' header
API_SECRET_KEY=
